# Claude authentication for the ACP adapter.
CLAUDE_OAUTH_TOKEN=<set-at-deploy-time>

# Harness API and optional Webex adapter.
CLAUDE_TEAM_HARNESS_API_TOKEN=<set-at-deploy-time>
WEBEX_BOT_TOKEN=<set-at-deploy-time>
WEBEX_WEBHOOK_SECRET=<set-at-deploy-time>

# Example Atlassian MCP profile values.
JIRA_BASE_URL=https://jira.example.com
JIRA_USER_EMAIL=<set-at-deploy-time>
JIRA_API_TOKEN=<set-at-deploy-time>
